{
  "apiVersion": "v1beta",
  "webVitals": {
    "eventNames": ["LCP", "CLS", "INP", "FCP", "TTFB"],
    "dimensions": [
      { "name": "date" },
      { "name": "eventName" },
      { "name": "pagePath" },
      { "name": "customEvent:metric_rating" }
    ],
    "metrics": [
      { "name": "eventCount" },
      { "name": "customEvent:metric_value" }
    ]
  },
  "batchSize": 100000,
  "requestTimeout": 30000,
  "maxRetries": 3,
  "retryDelay": 2000
}
