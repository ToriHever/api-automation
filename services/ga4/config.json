{
  "apiVersion": "v1beta",
  "domain": "https://ddos-guard.ru",
  "webVitals": {
    "eventNames": ["webVitals"],
    "dimensions": [
      { "name": "date" },
      { "name": "pagePath" },
      { "name": "customEvent:metric_name" }
    ],
    "metrics": [
      { "name": "eventCount" },
      { "name": "customEvent:metric_value" }
    ]
  },
  "batchSize": 100000,
  "requestTimeout": 30000,
  "maxRetries": 3,
  "retryDelay": 2000
}
